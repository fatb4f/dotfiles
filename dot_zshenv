# Home zshenv shim.
# Minimal path to the real ZDOTDIR startup file.

: "${HOME:?HOME is required}"
: "${XDG_CONFIG_HOME:=$HOME/.config}"

export XDG_CONFIG_HOME
export ZDOTDIR="${ZDOTDIR:-$XDG_CONFIG_HOME/zsh}"

if [ -z "${__ZDOTDIR_ZSHENV_LOADED:-}" ] && [ -r "$ZDOTDIR/.zshenv" ]; then
  __ZDOTDIR_ZSHENV_LOADED=1
  . "$ZDOTDIR/.zshenv"
  unset __ZDOTDIR_ZSHENV_LOADED
fi
