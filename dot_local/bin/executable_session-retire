#!/usr/bin/env bash
set -euo pipefail

die() {
  printf 'session-retire: %s\n' "$*" >&2
  exit 1
}

session_id="${XDG_SESSION_ID:-}"

# In a systemd user unit, XDG_SESSION_ID may be absent unless imported.
# Fall back to logind's display session for this user.
if [[ -z "$session_id" ]]; then
  session_id="$(loginctl show-user "$USER" -p Display --value 2>/dev/null || true)"
fi

[[ -n "$session_id" ]] || die "could not determine graphical session id"

# Defensive ownership check: terminate only this user's session.
session_user="$(loginctl show-session "$session_id" -p User --value 2>/dev/null || true)"
[[ -n "$session_user" ]] || die "session '$session_id' not found"

if [[ "$session_user" != "$(id -u)" ]]; then
  die "refusing to terminate session '$session_id' owned by uid '$session_user'"
fi

exec loginctl terminate-session "$session_id"
