#!/usr/bin/env bash
set -euo pipefail

root="${1:-$PWD}"
root="$(realpath "$root")"

hash="$(printf '%s' "$root" | sha1sum | cut -d' ' -f1)"
session="ide-${hash:0:12}"
runtime="${XDG_RUNTIME_DIR:-/tmp}"
sock="$runtime/nvim-${session}.sock"

export IDE_ROOT="$root"
export IDE_SESSION="$session"
export IDE_NVIM="$sock"
export EDITOR="nvim-open-here"

cd "$root"

ide-role files
ide-role editor
