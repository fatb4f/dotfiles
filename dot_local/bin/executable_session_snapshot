#!/usr/bin/env bash
set -u

ts="$(date -Is | tr ':' '-')"
out_dir="${XDG_STATE_HOME:-$HOME/.local/state}/session-snapshots"
out="$out_dir/session-snapshot-$ts.log"

mkdir -p "$out_dir"

section() {
  printf '\n\n# %s\n' "$*" | tee -a "$out"
}

run() {
  printf '\n$ %s\n' "$*" | tee -a "$out"
  "$@" >>"$out" 2>&1 || {
    rc=$?
    printf '[exit %s]\n' "$rc" >>"$out"
    return 0
  }
}

say() {
  printf '%s\n' "$*" | tee -a "$out"
}

section "snapshot metadata"
say "timestamp=$ts"
say "host=$(hostname)"
say "user=$USER"
say "uid=$(id -u)"
say "out=$out"

section "session environment"
for k in \
  WAYLAND_DISPLAY \
  XDG_SESSION_ID \
  XDG_SESSION_TYPE \
  XDG_CURRENT_DESKTOP \
  XDG_RUNTIME_DIR \
  DBUS_SESSION_BUS_ADDRESS \
  APP2UNIT_TYPE \
  APP2UNIT_SLICES \
  UWSM_APP_UNIT_TYPE
do
  printf '%s=%q\n' "$k" "${!k-}" | tee -a "$out"
done

section "command surface"
for cmd in \
  niri \
  uwsm \
  app2unit \
  fuzzel \
  swaylock \
  stasis \
  fnott \
  loginctl \
  systemctl \
  systemd-cgls
do
  run command -v "$cmd"
done

section "loginctl session state"
run loginctl
run loginctl session-status "${XDG_SESSION_ID:-self}"

section "systemd user manager state"
run systemctl --user is-system-running
run systemctl --user list-dependencies graphical-session.target

section "critical unit status"
for unit in \
  graphical-session.target \
  wayland-session@niri.desktop.target \
  wayland-wm@niri.desktop.service \
  noctalia-shell.service \
  fnott.service \
  stasis.service \
  logind-lock-listener.service \
  session-lock.service \
  locked-session-halt.timer \
  locked-session-halt.service
do
  section "unit: $unit"
  run systemctl --user status "$unit" --no-pager
  run systemctl --user is-enabled "$unit"
  run systemctl --user show "$unit" \
    -p Id \
    -p Names \
    -p LoadState \
    -p ActiveState \
    -p SubState \
    -p FragmentPath \
    -p UnitFileState \
    -p WantedBy \
    -p Wants \
    -p PartOf \
    -p After \
    -p Before \
    -p ControlGroup \
    -p MainPID \
    -p ExecStart
done

section "active graphical/app/session units"
run systemctl --user list-units \
  'graphical-session*' \
  'wayland-*' \
  'app-*' \
  'background-*' \
  'session-*' \
  'app2unit*' \
  'noctalia*' \
  'fnott*' \
  'stasis*' \
  'logind-lock-listener*' \
  --no-pager

section "app2unit/app scopes"
run systemctl --user list-units \
  'app-*.scope' \
  'app-*.service' \
  'background-*.scope' \
  'background-*.service' \
  'session-*.scope' \
  'session-*.service' \
  --no-pager

section "cgroup: niri compositor service"
run systemd-cgls --user-unit wayland-wm@niri.desktop.service

section "cgroup: app graphical slice"
run systemd-cgls --user-unit app-graphical.slice

section "cgroup: background graphical slice"
run systemd-cgls --user-unit background-graphical.slice

section "cgroup: session graphical slice"
run systemd-cgls --user-unit session-graphical.slice

section "process tree hints"
run pgrep -a niri
run pgrep -a app2unit
run pgrep -a fuzzel
run pgrep -a swaylock
run pgrep -a stasis
run pgrep -a fnott
run pgrep -a noctalia

section "niri-related processes"
run ps -eo pid,ppid,stat,unit,user,comm,args --sort=unit,args

section "runtime-only invariant checks"

check_disabled() {
  local unit="$1"
  local state
  state="$(systemctl --user is-enabled "$unit" 2>/dev/null || true)"

  case "$state" in
    disabled|static|indirect|masked|"")
      say "OK: $unit is not directly enabled: $state"
      ;;
    *)
      say "WARN: $unit appears enabled: $state"
      ;;
  esac
}

check_disabled session-lock.service
check_disabled locked-session-halt.timer
check_disabled locked-session-halt.service

section "duplicate app-niri-qs check"
dup_count="$(
  systemctl --user list-units 'app-niri-qs*' --no-legend --no-pager 2>/dev/null \
    | awk 'NF { n++ } END { print n+0 }'
)"
say "app-niri-qs unit count=$dup_count"
if [ "$dup_count" -gt 1 ]; then
  say "WARN: duplicate app-niri-qs units detected"
else
  say "OK: no duplicate app-niri-qs units detected"
fi

section "quick verdict hints"
say "Review these manually:"
say "- wayland-wm@niri.desktop.service should contain niri only"
say "- apps should appear under app-graphical.slice / app-*.scope"
say "- Noctalia/fnott/Stasis/logind-lock-listener should remain normal user services"
say "- session-lock.service and locked-session-halt.* should not be enabled directly"
say "- Mod+Alt+L should remain direct to /home/_404/.local/bin/session-lock"

say ""
say "snapshot written: $out"
