#!/usr/bin/env bash
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprlock.conf"

# Avoid duplicate locker instances.
if pidof hyprlock >/dev/null 2>&1; then
  exit 0
fi

# Runtime-only abandoned-lock deadline.
systemctl --user start locked-session-halt.timer || true

/usr/bin/hyprlock --config "$config" --immediate-render --no-fade-in
rc=$?

# Hyprlock exits after successful auth/unlock.
systemctl --user stop locked-session-halt.timer || true

sid="${XDG_SESSION_ID:-}"
if [[ -z "$sid" ]]; then
  sid="$(loginctl show-user "$USER" -p Display --value 2>/dev/null || true)"
fi

if [[ -n "$sid" ]]; then
  loginctl unlock-session "$sid" || true
else
  loginctl unlock-session || true
fi

exit "$rc"
