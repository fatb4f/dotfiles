#!/usr/bin/env bash
set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/swaylock/config"
sid="${XDG_SESSION_ID:-}"

if [[ -z "$sid" ]]; then
  sid="$(loginctl show-user "$USER" -p Display --value 2>/dev/null || true)"
fi

# Mark/refresh logind lock state. If this service was started by the
# logind Lock signal, this is idempotent.
if [[ -n "$sid" ]]; then
  loginctl lock-session "$sid" || true
else
  loginctl lock-session || true
fi

/usr/bin/swaylock --config "$config"
rc=$?

# Swaylock exits after successful unlock/auth. Publish that state back
# to logind so the listener can disarm locked-session-halt.timer.
if [[ -n "$sid" ]]; then
  loginctl unlock-session "$sid" || true
else
  loginctl unlock-session || true
fi

exit "$rc"
