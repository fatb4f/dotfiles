#!/usr/bin/env sh
set -eu

role="${1:-editor}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$role" in
  editor | ide)
    ide="${DOTFILES_IDE:-${DOTFILES_EDITOR:-${EDITOR:-nvim}}}"
    ;;
  *)
    printf '%s\n' "ide-role: unsupported role '$role'" >&2
    printf '%s\n' "ide-role: supported roles: editor, ide" >&2
    exit 64
    ;;
esac

if ! command -v "$ide" >/dev/null 2>&1; then
  printf '%s\n' "ide-role: configured IDE/editor '$ide' was not found in PATH" >&2
  printf '%s\n' "ide-role: set DOTFILES_IDE or DOTFILES_EDITOR to an installed role" >&2
  exit 127
fi

exec "$ide" "$@"
