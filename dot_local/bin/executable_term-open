#!/usr/bin/env sh
set -eu

terminal="${DOTFILES_TERMINAL:-${TERMINAL:-wezterm}}"

if ! command -v "$terminal" >/dev/null 2>&1; then
  printf '%s\n' "term-open: configured terminal '$terminal' was not found in PATH" >&2
  printf '%s\n' "term-open: set DOTFILES_TERMINAL to an installed terminal role" >&2
  exit 127
fi

exec "$terminal" "$@"
