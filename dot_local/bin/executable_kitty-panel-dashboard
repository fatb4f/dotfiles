#!/usr/bin/env bash
set -euo pipefail

panel="$HOME/.local/src/kitty-panel/kittyPanel.js"
js_bin="$(command -v js || true)"

[[ -f "$panel" ]] || {
  echo "missing: $panel" >&2
  exit 127
}

[[ -n "$js_bin" ]] || {
  echo "missing dependency: js" >&2
  exit 127
}

exec kitty -1 \
  -o allow_remote_control=yes \
  -o window_margin_width=0 \
  --hold \
  -o background_opacity=0.8 \
  -o window_border_width=0 \
  "$js_bin" "$panel"
