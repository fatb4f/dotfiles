#!/usr/bin/env bash
set -euo pipefail

appname="${NVIM_APPNAME:-nvim}"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/nvim-debug"
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
out="$state_root/$stamp"

mkdir -p "$out"

run_nvim() {
  NVIM_APPNAME="$appname" nvim "$@"
}

write_json_string() {
  python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))'
}

# -------------------------------------------------------------------
# 0. Static identity
# -------------------------------------------------------------------

{
  printf 'timestamp_utc=%s\n' "$stamp"
  printf 'NVIM_APPNAME=%s\n' "$appname"
  printf 'PWD=%s\n' "$PWD"
  printf 'SHELL=%s\n' "${SHELL:-}"
  printf 'TERM=%s\n' "${TERM:-}"
  printf 'PATH=%s\n' "${PATH:-}"
} > "$out/env.txt"

nvim --version > "$out/nvim-version.txt" 2>&1 || true

# -------------------------------------------------------------------
# 1. Ask Neovim for authority paths
# -------------------------------------------------------------------

run_nvim --headless \
  +'lua print(vim.fn.stdpath("config"))' \
  +qa! > "$out/stdpath-config.txt" 2>"$out/stdpath-config.err" || true

run_nvim --headless \
  +'lua print(vim.fn.stdpath("data"))' \
  +qa! > "$out/stdpath-data.txt" 2>"$out/stdpath-data.err" || true

run_nvim --headless \
  +'lua print(vim.fn.stdpath("state"))' \
  +qa! > "$out/stdpath-state.txt" 2>"$out/stdpath-state.err" || true

run_nvim --headless \
  +'lua print(vim.fn.stdpath("cache"))' \
  +qa! > "$out/stdpath-cache.txt" 2>"$out/stdpath-cache.err" || true

run_nvim --headless \
  +'lua print(vim.fn.stdpath("log"))' \
  +qa! > "$out/stdpath-log.txt" 2>"$out/stdpath-log.err" || true

# -------------------------------------------------------------------
# 2. Startup trace
# -------------------------------------------------------------------

NVIM_LOG_FILE="$out/nvim.log" \
run_nvim --headless \
  -V3"$out/startup.verbose.log" \
  +'redir! > '"$out"'/messages.txt' \
  +'silent messages' \
  +'redir END' \
  +qa! \
  > "$out/startup.out" \
  2> "$out/startup.err" || true

# -------------------------------------------------------------------
# 3. Health reports
# -------------------------------------------------------------------

run_nvim --headless \
  +'checkhealth' \
  +'w! '"$out"'/checkhealth.txt' \
  +qa! \
  > "$out/checkhealth.out" \
  2> "$out/checkhealth.err" || true

run_nvim --headless \
  +'checkhealth lazy' \
  +'w! '"$out"'/checkhealth-lazy.txt' \
  +qa! \
  > "$out/checkhealth-lazy.out" \
  2> "$out/checkhealth-lazy.err" || true

run_nvim --headless \
  +'checkhealth lazyvim' \
  +'w! '"$out"'/checkhealth-lazyvim.txt' \
  +qa! \
  > "$out/checkhealth-lazyvim.out" \
  2> "$out/checkhealth-lazyvim.err" || true

run_nvim --headless \
  +'checkhealth vim.lsp' \
  +'w! '"$out"'/checkhealth-lsp.txt' \
  +qa! \
  > "$out/checkhealth-lsp.out" \
  2> "$out/checkhealth-lsp.err" || true

run_nvim --headless \
  +'checkhealth mason' \
  +'w! '"$out"'/checkhealth-mason.txt' \
  +qa! \
  > "$out/checkhealth-mason.out" \
  2> "$out/checkhealth-mason.err" || true

run_nvim --headless \
  +'checkhealth nvim-treesitter' \
  +'w! '"$out"'/checkhealth-treesitter.txt' \
  +qa! \
  > "$out/checkhealth-treesitter.out" \
  2> "$out/checkhealth-treesitter.err" || true

# -------------------------------------------------------------------
# 4. lazy.nvim machine-ish state
# -------------------------------------------------------------------

run_nvim --headless \
  +'lua local ok,lazy=pcall(require,"lazy"); if ok then vim.print(lazy.stats()) else print("lazy unavailable:", lazy) end' \
  +qa! \
  > "$out/lazy-stats.txt" \
  2> "$out/lazy-stats.err" || true

run_nvim --headless \
  +'lua local ok,config=pcall(require,"lazy.core.config"); if ok then for name,plugin in pairs(config.plugins or {}) do print(name .. "\t" .. tostring(plugin._.loaded or false) .. "\t" .. tostring(plugin.dir or "")) end else print("lazy.core.config unavailable:", config) end' \
  +qa! \
  > "$out/lazy-plugins.tsv" \
  2> "$out/lazy-plugins.err" || true

# -------------------------------------------------------------------
# 5. LSP log path
# -------------------------------------------------------------------

run_nvim --headless \
  +'lua if vim.lsp and vim.lsp.log and vim.lsp.log.get_filename then print(vim.lsp.log.get_filename()) else print("vim.lsp.log.get_filename unavailable") end' \
  +qa! \
  > "$out/lsp-log-path.txt" \
  2> "$out/lsp-log-path.err" || true

# -------------------------------------------------------------------
# 6. Copy persistent logs
# -------------------------------------------------------------------

logdir="$(cat "$out/stdpath-log.txt" 2>/dev/null | tail -n 1 || true)"
if [ -n "${logdir:-}" ] && [ -d "$logdir" ]; then
  mkdir -p "$out/copied-logs"
  find "$logdir" -maxdepth 1 -type f -print0 |
    xargs -0 -r -I{} cp -f "{}" "$out/copied-logs/"
fi

# -------------------------------------------------------------------
# 7. Summary report
# -------------------------------------------------------------------

verdict="clean"
if grep -RqiE '(^|\s)(error|failed|traceback|exception|not an editor command|module .* not found)' "$out"; then
  verdict="suspect"
fi

cat > "$out/report.json" <<EOF
{
  "schema": "nvim.lazyvim.headless-log-bundle.v1",
  "timestamp_utc": "$stamp",
  "nvim_appname": "$(printf '%s' "$appname" | write_json_string)",
  "verdict": "$verdict",
  "artifact_dir": "$(printf '%s' "$out" | write_json_string)",
  "primary_files": {
    "startup_stderr": "startup.err",
    "startup_verbose": "startup.verbose.log",
    "messages": "messages.txt",
    "checkhealth": "checkhealth.txt",
    "checkhealth_lazy": "checkhealth-lazy.txt",
    "checkhealth_lazyvim": "checkhealth-lazyvim.txt",
    "checkhealth_lsp": "checkhealth-lsp.txt",
    "lazy_stats": "lazy-stats.txt",
    "lazy_plugins": "lazy-plugins.tsv",
    "copied_logs": "copied-logs/"
  }
}
EOF

printf '%s\n' "$out"
