#!/usr/bin/env bash
set -euo pipefail

desktop="${XDG_CURRENT_DESKTOP:-}"

case "${desktop,,}" in
  *hyprland*)
    exec "$HOME/.local/bin/hyprlock-logind-session"
    ;;
  *niri*)
    exec "$HOME/.local/bin/swaylock-logind-session"
    ;;
esac

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  exec "$HOME/.local/bin/hyprlock-logind-session"
fi

if command -v niri >/dev/null 2>&1 && [[ "${WAYLAND_DISPLAY:-}" ]]; then
  exec "$HOME/.local/bin/swaylock-logind-session"
fi

printf 'wayland-lock-session: unknown compositor: XDG_CURRENT_DESKTOP=%q\n' "$desktop" >&2
exit 1
