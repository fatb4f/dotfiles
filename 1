# frame begin
# Frame lifecycle hook wiring for Codex config.toml.
#
# Install Frame to:
#   $CODEX_HOME/tools/frame
#
# This keeps the same hook scope as the old Hookrail wiring, but the active
# runtime is Frame.

[[hooks.SessionStart]]
matcher = "startup|resume|clear|compact"

[[hooks.SessionStart.hooks]]
type = "command"
command = "sh -lc 'CODEX_HOME=\"${CODEX_HOME:-$HOME/.codex}\"; exec \"$CODEX_HOME/tools/frame/bin/frame\" hook run'"
timeout = 10
statusMessage = "Frame: loading session frame"

[[hooks.UserPromptSubmit]]

[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = "sh -lc 'CODEX_HOME=\"${CODEX_HOME:-$HOME/.codex}\"; exec \"$CODEX_HOME/tools/frame/bin/frame\" hook run'"
timeout = 10
statusMessage = "Frame: checking prompt pressure"

[[hooks.PostToolUse]]
matcher = "*"

[[hooks.PostToolUse.hooks]]
type = "command"
command = "sh -lc 'CODEX_HOME=\"${CODEX_HOME:-$HOME/.codex}\"; exec \"$CODEX_HOME/tools/frame/bin/frame\" hook run'"
timeout = 30
statusMessage = "Frame: capturing tool evidence"

[[hooks.Stop]]

[[hooks.Stop.hooks]]
type = "command"
command = "sh -lc 'CODEX_HOME=\"${CODEX_HOME:-$HOME/.codex}\"; exec \"$CODEX_HOME/tools/frame/bin/frame\" hook run'"
timeout = 30
statusMessage = "Frame: writing closeout frame"
# frame end
