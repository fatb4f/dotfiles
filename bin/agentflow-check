#!/usr/bin/env sh
set -eu

usage() {
	printf 'usage: %s RUN_MANIFEST.cue\n' "$0" >&2
}

if [ "$#" -ne 1 ]; then
	usage
	exit 64
fi

manifest=$1

if [ ! -f "$manifest" ]; then
	printf 'agentflow-check: no such manifest: %s\n' "$manifest" >&2
	exit 66
fi

base=$(basename "$manifest" .cue)
run_name=$(printf '%s\n' "$base" | awk -F- '{
	out = $1
	for (i = 2; i <= NF; i++) {
		out = out toupper(substr($i, 1, 1)) substr($i, 2)
	}
	print out
}')

manifest_dir=$(dirname "$manifest")
overlay=$(mktemp "$manifest_dir/.agentflow-check.XXXXXX.cue")
trap 'rm -f "$overlay"' EXIT HUP INT TERM

{
	printf 'package runs\n\n'
	printf 'import agentflow "github.com/fatb4f/dotfiles/cue/contracts/agentflow"\n\n'
	printf '_acceptedAgentFlowRun: agentflow.#AcceptedAgentFlowRun & %s\n' "$run_name"
} >"$overlay"

cue export "$manifest" "$overlay" -e _acceptedAgentFlowRun --out json >/dev/null
