#!/usr/bin/env sh
set -eu

usage() {
	printf 'usage: %s --manifest RUN_MANIFEST.cue -- command...\n' "$0" >&2
}

manifest=

while [ "$#" -gt 0 ]; do
	case "$1" in
	--manifest)
		if [ "$#" -lt 2 ]; then
			usage
			exit 64
		fi
		manifest=$2
		shift 2
		;;
	--)
		shift
		break
		;;
	*)
		usage
		exit 64
		;;
	esac
done

if [ -z "$manifest" ]; then
	usage
	exit 64
fi

if [ "$#" -eq 0 ]; then
	usage
	exit 64
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
"$script_dir/agentflow-check" "$manifest"

exec "$@"
