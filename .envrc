strict_env
direnv_version 2.37.1

watch_file pyproject.toml \
  uv.lock \
  .codex/context-workbook/context-workbook.py

has uv || {
  log_error "uv is required"
  return 1
}

export CONTEXT_WORKBOOK_REPO_ROOT="$PWD"
export UV_PROJECT_ENVIRONMENT="$PWD/.venv"
export VIRTUAL_ENV="$UV_PROJECT_ENVIRONMENT"
export CONTEXT_WORKBOOK_PYTHON="$VIRTUAL_ENV/bin/python"
unset PYTHONHOME

if [[ ! -x "$CONTEXT_WORKBOOK_PYTHON" ]]; then
  log_error "missing locked environment; run: uv sync --locked"
  return 1
fi

PATH_add "$VIRTUAL_ENV/bin"

uv lock --check --project "$PWD" >/dev/null || {
  log_error "uv.lock does not match pyproject.toml"
  return 1
}

# uv sync is exact by default; --inexact is intentionally not used.
uv sync --check --locked --project "$PWD" >/dev/null || {
  log_error "the active uv environment is not exactly synchronized"
  return 1
}

[[ "$(command -v python)" == "$CONTEXT_WORKBOOK_PYTHON" ]] || {
  log_error "python does not resolve to the context workbook uv environment"
  return 1
}
