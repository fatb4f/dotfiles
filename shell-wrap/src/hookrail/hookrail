  hookrail_doctor_check "feed sentinel trace row emits" -- bash -c 'cd "$1" && cue export . "$2" -e "#HookProjection.traceRow" --out json >"$3"' bash "$cue_dir" "$cue_dir/fixtures/session-start-feed-sentinel.json" "$trace_row"
