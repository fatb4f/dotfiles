  hookrail_doctor_check "no-feed proof red" -- bash -c 'cd "$1" && cue export . "$2" -e "#HookProjection.feedProof" --out json >"$3"' bash "$cue_dir" "$cue_dir/fixtures/session-start-no-feed.json" "$proof_json"
