  declare -g long_usage=''
  declare -g -A args=()
  declare -g -A deps=()
  declare -g -a env_var_names=()
  declare -g -a input=()

  normalize_input "$@"
  parse_requirements "${input[@]}"

  case "$action" in
    "lock") session_lock_command ;;
    "session-lock") session_session_lock_command ;;
    "unlock") session_unlock_command ;;
    "auto-start") session_auto_start_command ;;
    "session-auto-start") session_session_auto_start_command ;;
