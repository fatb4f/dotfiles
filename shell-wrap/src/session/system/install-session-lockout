#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
session_src="$(cd -- "$script_dir/.." && pwd)/session"

if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
  printf 'install-session-lockout: must run as root\n' >&2
  exit 1
fi

install -o root -g root -m 0755 "$session_src" /usr/local/bin/session
install -d -o root -g root -m 0755 /run/session-lockout

printf '%s\n' 'installed /usr/local/bin/session'
printf '%s\n' 'review system/pam/hyprlock.lockout.example before editing /etc/pam.d/hyprlock'
printf '%s\n' 'review system/sudoers/session-lockout with visudo before installing to /etc/sudoers.d/session-lockout'
