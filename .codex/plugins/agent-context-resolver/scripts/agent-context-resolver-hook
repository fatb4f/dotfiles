#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
plugin_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
repo_root=$(CDPATH= cd -- "$plugin_root/../../.." && pwd -P)
runner="$repo_root/.codex/context-workbook/run-context-workbook"

[ -f "$runner" ] || {
	printf '%s\n' 'agent-context-resolver: context workbook runner unavailable' >&2
	exit 2
}

input_json=$(mktemp "${TMPDIR:-/tmp}/agent-context-resolver.XXXXXX.json")
output_json=$(mktemp "${TMPDIR:-/tmp}/agent-context-resolver.XXXXXX.out")
trap 'rm -f "$input_json" "$output_json"' EXIT HUP INT TERM
cat >"$input_json"

if sh "$runner" --repo-root "$repo_root" --hook <"$input_json" >"$output_json"; then
	cat "$output_json"
	exit 0
fi

# Transport-level fail-closed response. No context selection or lexical fallback
# occurs here; the absence of the canonical workbook is represented explicitly.
printf '%s\n' 'agent-context-resolver: canonical context workbook failed closed' >&2
python3 - <<'PY'
import json
payload = {
    "schema": "agent.resolver-prompt-surface.v2",
    "requestID": None,
    "sufficiency": {
        "state": "insufficient",
        "reasons": ["The canonical context workbook was unavailable."],
        "blockingGapIDs": ["gap.context-workbook-unavailable"],
        "unresolvedConflictIDs": [],
    },
    "context": None,
    "execution": {
        "mode": "prompt-only",
        "routeExecution": False,
        "sourceAuthority": False,
        "rawTranscriptForwarding": False,
    },
}
print(json.dumps({
    "hookSpecificOutput": {
        "hookEventName": "UserPromptSubmit",
        "additionalContext": json.dumps(payload, sort_keys=True, separators=(",", ":")),
    }
}, sort_keys=True, separators=(",", ":")))
PY
