#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
plugin_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
prompt=
revision=HEAD
requested_cwd=

find_repo_root() {
	if [ -n "$requested_cwd" ]; then
		if command -v git >/dev/null 2>&1; then
			candidate=$(git -C "$requested_cwd" rev-parse --show-toplevel 2>/dev/null || :)
			if [ -n "$candidate" ] &&
				[ -f "$candidate/.codex/context-workbook/run-context-workbook" ]; then
				CDPATH= cd -- "$candidate" && pwd -P
				return
			fi
		fi
		return 1
	fi
	if [ -n "${CONTEXT_WORKBOOK_REPO_ROOT:-}" ] &&
		[ -f "$CONTEXT_WORKBOOK_REPO_ROOT/.codex/context-workbook/run-context-workbook" ]; then
		CDPATH= cd -- "$CONTEXT_WORKBOOK_REPO_ROOT" && pwd -P
		return
	fi
	if command -v git >/dev/null 2>&1; then
		candidate=$(git -C "${PWD:-.}" rev-parse --show-toplevel 2>/dev/null || :)
		if [ -n "$candidate" ] &&
			[ -f "$candidate/.codex/context-workbook/run-context-workbook" ]; then
			CDPATH= cd -- "$candidate" && pwd -P
			return
		fi
	fi
	candidate=$(CDPATH= cd -- "$plugin_root/../../.." 2>/dev/null && pwd -P || :)
	if [ -n "$candidate" ] &&
		[ -f "$candidate/.codex/context-workbook/run-context-workbook" ]; then
		printf '%s\n' "$candidate"
		return
	fi
	return 1
}

while [ "$#" -gt 0 ]; do
	case $1 in
	--prompt)
		[ "$#" -ge 2 ] || exit 2
		prompt=$2
		shift 2
		;;
	--candidate)
		[ "$#" -ge 2 ] || exit 2
		revision=$2
		shift 2
		;;
	--cwd)
		[ "$#" -ge 2 ] || exit 2
		requested_cwd=$2
		shift 2
		;;
	*)
		printf 'resolve-agent-context: unknown argument: %s\n' "$1" >&2
		exit 2
		;;
	esac
done

[ -n "$prompt" ] || {
	printf '%s\n' 'resolve-agent-context: --prompt is required' >&2
	exit 2
}

repo_root=$(find_repo_root) || {
	printf '%s\n' 'resolve-agent-context: canonical context workbook unavailable' >&2
	exit 2
}
runner="$repo_root/.codex/context-workbook/run-context-workbook"

exec sh "$runner" \
	--repo-root "$repo_root" \
	--prompt "$prompt" \
	--revision "$revision" \
	--output state
