#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)
plugin_root=$(CDPATH= cd -- "$script_dir/.." && pwd -P)
repo_root=$(CDPATH= cd -- "$plugin_root/../../.." && pwd -P)
runner="$repo_root/.codex/context-workbook/run-context-workbook"
prompt=
revision=HEAD

while [ "$#" -gt 0 ]; do
	case $1 in
	--prompt)
		[ "$#" -ge 2 ] || exit 2
		prompt=$2
		shift 2
		;;
	--candidate)
		[ "$#" -ge 2 ] || exit 2
		revision=$2
		shift 2
		;;
	--cwd)
		[ "$#" -ge 2 ] || exit 2
		shift 2
		;;
	*)
		printf 'resolve-agent-context: unknown argument: %s\n' "$1" >&2
		exit 2
		;;
	esac
done

[ -n "$prompt" ] || {
	printf '%s\n' 'resolve-agent-context: --prompt is required' >&2
	exit 2
}

exec "$runner" \
	--repo-root "$repo_root" \
	--prompt "$prompt" \
	--revision "$revision" \
	--output state
