{
  "schema": "codex.plugin.agent-context-resolver.v1",
  "id": "dotfiles.agent-context-resolver",
  "repo": "fatb4f/dotfiles",
  "runtime": {
    "requires": ["sh", "python3", "cue", "git"],
    "externalRepos": false,
    "cueAtRuntime": true,
    "canonicalWorkbook": ".codex/context-workbook/context-workbook.py",
    "reasoningEngine": "dspy",
    "lexicalFallback": false
  },
  "entrypoints": {
    "hook": ".codex/plugins/agent-context-resolver/scripts/agent-context-resolver-hook",
    "cli": ".codex/plugins/agent-context-resolver/scripts/resolve-agent-context",
    "browserlessWorkbook": ".codex/context-workbook/workbook_cli.py"
  },
  "generated": {
    "contextWorkbookProjection": ".codex/plugins/agent-context-resolver/generated/context-workbook-projection.json",
    "legacyPromptRoutes": ".codex/plugins/agent-context-resolver/generated/prompt_routes.json",
    "legacyRouteInventory": ".codex/plugins/agent-context-resolver/generated/route_inventory.json",
    "fragmentInventory": ".codex/plugins/agent-context-resolver/generated/fragment_inventory.json"
  },
  "denies": [
    "broad repo scan",
    "raw transcript forwarding",
    "raw registry dump",
    "unselected fragment injection",
    "runtime route execution",
    "lexical prompt classification",
    "DSPy source authority"
  ]
}
