{
  "schema": "dotfiles.semantic-provider.schema-map.v0",
  "repo": "fatb4f/dotfiles",
  "generatedFrom": "dotfiles-bundled-agent-context-resolver",
  "runtime": {
    "providersExecutable": true,
    "hookExecutesProviders": false,
    "externalReposRequired": false,
    "cueAtRuntime": false,
    "providerOutputIsContext": false,
    "providerOutputIsAuthority": false
  },
  "providerCatalogue": ".codex/plugins/agent-context-resolver/generated/provider_inventory.json",
  "providers": [
    {
      "id": "df:provider/codex-cli",
      "surface": "agent-runtime",
      "callable": false,
      "authority": "bounded-patch-executor",
      "mapsTo": [
        "dotfiles.patch.execute",
        "dotfiles.validation.report"
      ]
    },
    {
      "id": "df:provider/cue-rg",
      "surface": "bounded-text-evidence",
      "callable": false,
      "authority": "bounded-text-evidence",
      "mapsTo": [
        "dotfiles.issue.inspect",
        "dotfiles.workspace-ide.plan",
        "dotfiles.nvim-workflow.inspect"
      ]
    },
    {
      "id": "df:provider/cue-lsp",
      "surface": "cue-graph",
      "callable": true,
      "authority": "cue-graph",
      "capabilities": [
        "definition",
        "references",
        "hover",
        "diagnostics",
        "documentSymbols",
        "workspaceSymbols",
        "validate",
        "evidence"
      ],
      "mcp": {
        "serverID": "df:mcp/cue-lsp",
        "transport": "stdio",
        "adapter": "lsp-over-mcp",
        "toolPrefix": "cue_lsp",
        "tools": {
          "definition": "cue_lsp.definition",
          "references": "cue_lsp.references",
          "hover": "cue_lsp.hover",
          "diagnostics": "cue_lsp.diagnostics",
          "documentSymbols": "cue_lsp.document_symbols",
          "workspaceSymbols": "cue_lsp.workspace_symbols",
          "validate": "cue_lsp.validate",
          "evidence": "cue_lsp.evidence"
        }
      },
      "mapsTo": [
        "dotfiles.cue-validation",
        "dotfiles.manifest-slice"
      ]
    },
    {
      "id": "df:provider/lua-lsp",
      "surface": "lua-implementation",
      "callable": true,
      "authority": "lua-implementation",
      "capabilities": [
        "definition",
        "references",
        "hover",
        "diagnostics",
        "documentSymbols",
        "workspaceSymbols",
        "evidence"
      ],
      "mcp": {
        "serverID": "df:mcp/lua-lsp",
        "transport": "stdio",
        "adapter": "lsp-over-mcp",
        "toolPrefix": "lua_lsp",
        "tools": {
          "definition": "lua_lsp.definition",
          "references": "lua_lsp.references",
          "hover": "lua_lsp.hover",
          "diagnostics": "lua_lsp.diagnostics",
          "documentSymbols": "lua_lsp.document_symbols",
          "workspaceSymbols": "lua_lsp.workspace_symbols",
          "evidence": "lua_lsp.evidence"
        }
      },
      "mapsTo": [
        "dotfiles.workspace-ide.plan",
        "dotfiles.nvim-workflow.inspect",
        "dotfiles.wezterm-lua",
        "dotfiles.xplr-sidebar"
      ]
    },
    {
      "id": "df:provider/wezterm-types",
      "surface": "wezterm-lua-type-surface",
      "callable": false,
      "authority": "wezterm-lua-type-surface",
      "upstream": "DrKJeff16/wezterm-types",
      "mapsTo": [
        "dotfiles.workspace-ide.plan",
        "dotfiles.provider-catalogue.inspect"
      ]
    },
    {
      "id": "df:provider/chezmoi",
      "surface": "deployment-provenance",
      "callable": false,
      "authority": "deployment-provenance",
      "mapsTo": []
    }
  ],
  "semanticSurfaces": {
    "dotfiles.wezterm-lua": {
      "authority": "lua-implementation",
      "files": [
        "chezmoi/private_dot_config/wezterm/**"
      ],
      "providerIDs": [
        "df:provider/lua-lsp",
        "df:provider/wezterm-types",
        "df:provider/cue-rg"
      ]
    },
    "dotfiles.nvim-workflow": {
      "authority": "lua-implementation",
      "files": [
        "chezmoi/private_dot_config/nvim/lua/workflow/**"
      ],
      "providerIDs": [
        "df:provider/lua-lsp",
        "df:provider/cue-rg"
      ]
    },
    "dotfiles.xplr-sidebar": {
      "authority": "lua-implementation",
      "files": [
        "chezmoi/private_dot_config/xplr/init.lua"
      ],
      "providerIDs": [
        "df:provider/lua-lsp",
        "df:provider/cue-rg"
      ]
    },
    "dotfiles.cue-validation": {
      "authority": "cue-graph",
      "files": [
        ".github/dotfiles-manifest-slice/contracts/**"
      ],
      "providerIDs": [
        "df:provider/cue-lsp",
        "df:provider/codex-cli",
        "df:provider/cue-rg"
      ]
    }
  },
  "mcpExecutionPolicy": {
    "providersReachable": true,
    "hookMayExecuteProviders": false,
    "rawProviderOutputIsContext": false,
    "rawProviderOutputIsAuthority": false,
    "requiresEvidenceWrapper": true,
    "routeDeclaredFilesOnly": true
  },
  "notes": [
    "LSP providers are reachable over MCP as callable provider surfaces.",
    "The Codex hook still must not execute providers or inject raw provider output.",
    "Provider output must return as structured evidence for route-local use."
  ]
}
