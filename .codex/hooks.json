{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use.sh\"",
            "timeout": 30,
            "statusMessage": "Checking workspace workflow constraints"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/post_tool_use.sh\"",
            "timeout": 120,
            "statusMessage": "Validating workspace state"
          }
        ]
      }
    ]
  }
}
