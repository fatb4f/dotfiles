{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$|^apply_patch$|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && cue cmd preToolUse .codex/workflow.cue || exit 2'",
            "timeout": 30,
            "statusMessage": "Checking workspace constraints"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$|^apply_patch$|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && cue cmd postToolUse .codex/workflow.cue || exit 2'",
            "timeout": 60,
            "statusMessage": "Validating workspace state"
          }
        ]
      }
    ]
  }
}
