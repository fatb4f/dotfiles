{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && ./.codex/hooks/post-tool-use.sh'",
            "statusMessage": "Validating workflow.cue"
          }
        ]
      }
    ]
  }
}
