{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && payload=\"$(cat /dev/stdin)\" && { [ -n \"$payload\" ] || payload=\"{}\"; } && cue cmd -t hook=\"$payload\" validate ./.codex'",
            "statusMessage": "Validating workspace constraints"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && ./.codex/hooks/stop-closeout.sh'",
            "statusMessage": "Checking closeout"
          }
        ]
      }
    ]
  }
}
