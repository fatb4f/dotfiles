{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'cd \"$(git rev-parse --show-toplevel)\" && cue cmd validate .codex/workflow.cue'",
            "statusMessage": "Validating workspace constraints"
          }
        ]
      }
    ]
  }
}
