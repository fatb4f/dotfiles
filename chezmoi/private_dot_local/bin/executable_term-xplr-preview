#!/usr/bin/env bash
set -euo pipefail

root=${1:?usage: term-xplr-preview ROOT FIFO}
fifo=${2:?usage: term-xplr-preview ROOT FIFO}
max_lines=${TERM_XPLR_PREVIEW_LINES:-200}

root=$(realpath --canonicalize-existing "$root")

case "$fifo" in
	/*) ;;
	*) exit 64 ;;
esac

if ! [[ "$max_lines" =~ ^[0-9]+$ ]] || [ "$max_lines" -lt 1 ] || [ "$max_lines" -gt 1000 ]; then
	max_lines=200
fi

clear_screen() {
	printf '\033[2J\033[H'
}

inside_root() {
	local path=$1

	case "$path" in
		"$root" | "$root"/*) return 0 ;;
		*) return 1 ;;
	esac
}

print_header() {
	local path=$1
	local label=${path#"$root"/}

	if [ "$label" = "$path" ]; then
		label=.
	fi

	printf '\033[1m%s\033[0m\n\n' "$label"
}

bounded_file_metadata() {
	file --brief -- "$1" 2>/dev/null || printf 'unsupported path\n'
}

preview_dir() {
	local path=$1

	if command -v eza >/dev/null 2>&1; then
		eza --all --long --group-directories-first --color=always -- "$path" 2>/dev/null | head -n "$max_lines" || true
	else
		# shellcheck disable=SC2012
		LC_ALL=C ls -la --color=always -- "$path" 2>/dev/null | head -n "$max_lines" || true
	fi
}

preview_file() {
	local path=$1
	local mime

	mime=$(file --brief --mime -- "$path" 2>/dev/null || true)
	case "$mime" in
		text/* | */json* | */xml* | */yaml* | */x-shellscript* | */x-lua* | */x-python*)
			if command -v bat >/dev/null 2>&1; then
				bat --color=always --style=numbers --paging=never --line-range=":$max_lines" -- "$path" 2>/dev/null
			else
				sed -n "1,${max_lines}p" -- "$path" 2>/dev/null
			fi
			;;
		*)
			bounded_file_metadata "$path"
			;;
	esac
}

render() {
	local input=$1
	local path

	path=$(realpath --canonicalize-existing "$input" 2>/dev/null || true)
	clear_screen

	if [ -z "$path" ] || ! inside_root "$path"; then
		printf 'path unavailable\n'
		return
	fi

	print_header "$path"

	if [ -d "$path" ]; then
		preview_dir "$path"
	elif [ -f "$path" ]; then
		preview_file "$path"
	else
		bounded_file_metadata "$path"
	fi
}

clear_screen
printf 'waiting for xplr focus stream\n'

while IFS= read -r focused_path; do
	[ -n "$focused_path" ] || continue
	render "$focused_path"
done < "$fifo"
