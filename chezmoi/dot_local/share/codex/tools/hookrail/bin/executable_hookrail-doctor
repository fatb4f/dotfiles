#!/usr/bin/env python3
from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
HOOK = next(
    (
        path
        for path in (
            ROOT / "bin" / "hookrail-hook",
            ROOT / "bin" / "executable_hookrail-hook",
        )
        if path.exists()
    ),
    ROOT / "bin" / "hookrail-hook",
)
FIXTURES = ROOT / "fixtures" / "hooks"

required = [
    ROOT / "README.md",
    ROOT / "cue.mod" / "module.cue",
    ROOT / "cue" / "hooks.cue",
    ROOT / "cue" / "manifest.cue",
    HOOK,
]

failed = 0

def report(ok: bool, msg: str) -> None:
    global failed
    print(("PASS" if ok else "FAIL"), msg)
    if not ok:
        failed = 1

def run_hook(hook_cmd: list[str], event: dict, env: dict) -> tuple[subprocess.CompletedProcess[bytes], dict | None]:
    proc = subprocess.run(
        hook_cmd,
        input=json.dumps(event).encode(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
    )
    try:
        out = json.loads(proc.stdout.decode())
    except Exception:
        out = None
    return proc, out

def git(*args: str, cwd: Path) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        ["git", "-C", str(cwd), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

def init_git_fixture(path: Path, dirty: bool) -> None:
    git("init", cwd=path)
    git("config", "user.name", "Hookrail Doctor", cwd=path)
    git("config", "user.email", "hookrail-doctor@example.invalid", cwd=path)
    (path / "file.txt").write_text("x\n", encoding="utf-8")
    git("add", "file.txt", cwd=path)
    git("commit", "-m", "test: initial fixture", cwd=path)
    if dirty:
        with (path / "file.txt").open("a", encoding="utf-8") as fh:
            fh.write("y\n")

def stop_fixture(name: str, cwd: Path, active: bool = False) -> dict:
    data = json.loads((FIXTURES / name).read_text(encoding="utf-8"))
    data["cwd"] = str(cwd)
    data["stop_hook_active"] = active
    data["session_id"] = f"test-session-{name}"
    data["turn_id"] = "test-turn"
    return data

for path in required:
    report(path.exists(), f"exists {path.relative_to(ROOT)}")

fixtures = sorted(FIXTURES.glob("*.json"))
report(bool(fixtures), "fixtures present")

with tempfile.TemporaryDirectory() as td:
    env = dict(os.environ)
    env["HOOKRAIL_STATE"] = td
    hook_cmd = [str(HOOK)] if os.access(HOOK, os.X_OK) else [sys.executable, str(HOOK)]
    fixture_count = 0
    for fixture in fixtures:
        fixture_count += 1
        proc = subprocess.run(hook_cmd, input=fixture.read_bytes(), stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
        ok = proc.returncode == 0
        report(ok, f"{fixture.name} exits 0")
        report(not proc.stderr, f"{fixture.name} stderr empty")
        try:
            stdout = proc.stdout.decode()
            out = json.loads(stdout)
            report(isinstance(out, dict), f"{fixture.name} stdout JSON object")
            report("continue" in out or "decision" in out or "hookSpecificOutput" in out or "systemMessage" in out, f"{fixture.name} output shape")
            report(stdout.lstrip().startswith("{"), f"{fixture.name} stdout starts with JSON object")
            if fixture.name == "stop.json":
                report(out == {"continue": True}, f"{fixture.name} default output is bare continue")
        except Exception as exc:
            report(False, f"{fixture.name} invalid JSON: {exc}")

    persisted = list(Path(td).glob("runs/*/*/events/*.json"))
    report(bool(persisted), "at least one manifest persisted")
    manifests = []
    for path in persisted:
        try:
            manifests.append((path, json.loads(path.read_text())))
        except Exception as exc:
            report(False, f"{path.name} invalid manifest JSON: {exc}")

    trace_files = sorted((Path(td) / "trace").glob("*.jsonl"))
    report(bool(trace_files), "trace files present")
    trace_rows = []
    for path in trace_files:
        for line_no, line in enumerate(path.read_text().splitlines(), start=1):
            try:
                row = json.loads(line)
                report(isinstance(row, dict), f"{path.name}:{line_no} trace JSON object")
                trace_rows.append(row)
            except Exception as exc:
                report(False, f"{path.name}:{line_no} invalid trace JSON: {exc}")
    report(len(trace_rows) == fixture_count, "every fixture invocation appends one trace row")
    report(
        all({"timestamp", "hookEventName", "sessionID", "turnID", "cwd", "model", "transcriptPath", "persisted", "manifestPath"} <= set(row) for row in trace_rows),
        "trace rows include required fields",
    )
    report(
        any(row.get("hookEventName") == "PostToolUse" and row.get("persisted") is False for row in trace_rows),
        "PostToolUse small fixture traces without persistence",
    )
    report(
        any(row.get("hookEventName") == "Stop" and row.get("persisted") is True and row.get("manifestPath") for row in trace_rows),
        "Stop trace records persisted manifest",
    )

    small_prompt_manifests = [
        data
        for _path, data in manifests
        if data.get("hookEventName") == "UserPromptSubmit"
        and data.get("payload", {}).get("class") == "small"
    ]
    report(bool(small_prompt_manifests), "UserPromptSubmit small prompt persists metadata-only manifest")
    if small_prompt_manifests:
        manifest = small_prompt_manifests[0]
        report(manifest.get("prompt") == {"stored": False, "reason": "redacted-by-default"}, "UserPromptSubmit prompt is marked redacted")
        report("small bounded request" not in json.dumps(manifest, ensure_ascii=False), "UserPromptSubmit manifest omits raw prompt text")
    report(
        any(data.get("hookEventName") == "Stop" for _path, data in manifests),
        "Stop persists manifest",
    )

    clean_repo = Path(td) / "clean-repo"
    dirty_repo = Path(td) / "dirty-repo"
    evidence_repo = Path(td) / "evidence-repo"
    clean_repo.mkdir()
    dirty_repo.mkdir()
    evidence_repo.mkdir()
    init_git_fixture(clean_repo, dirty=False)
    init_git_fixture(dirty_repo, dirty=True)
    init_git_fixture(evidence_repo, dirty=True)

    policy_path = Path(td) / "policy.json"
    policy_path.write_text(json.dumps({"commitBeforeSummary": True}), encoding="utf-8")

    proc, out = run_hook(hook_cmd, stop_fixture("stop-clean.json", clean_repo), env)
    report(proc.returncode == 0, "Stop clean repo exits 0")
    report(not proc.stderr, "Stop clean repo stderr empty")
    report(out == {"continue": True}, "clean repo Stop returns bare continue")

    proc, out = run_hook(hook_cmd, stop_fixture("stop-dirty.json", dirty_repo), env)
    report(proc.returncode == 0, "Stop dirty repo exits 0")
    report(not proc.stderr, "Stop dirty repo stderr empty")
    report(isinstance(out, dict), "Stop dirty repo stdout JSON object")
    report(out is not None and out.get("decision") == "block", "dirty repo without evidence blocks")
    report(out is not None and "git-workflow" in out.get("reason", ""), "dirty block reason names git-workflow")

    proc, out = run_hook(hook_cmd, stop_fixture("stop-dirty-active.json", dirty_repo, active=True), env)
    report(proc.returncode == 0, "Stop dirty active exits 0")
    report(not proc.stderr, "Stop dirty active stderr empty")
    report(isinstance(out, dict), "Stop dirty active stdout JSON object")
    report(out is not None and out.get("continue") is True and out.get("decision") != "block", "dirty active Stop does not repeat block")

    evidence_event = stop_fixture("stop-dirty.json", evidence_repo)
    evidence_dir = Path(td) / "runs" / evidence_event["session_id"] / evidence_event["turn_id"]
    evidence_dir.mkdir(parents=True, exist_ok=True)
    (evidence_dir / "git-closeout.json").write_text(
        json.dumps(
            {
                "schema": "hookrail.git-closeout.v1",
                "sessionID": evidence_event["session_id"],
                "turnID": evidence_event["turn_id"],
                "cwd": str(evidence_repo),
                "commit": "976e9f15e23e445ae521bf5293e77d404fff790d",
                "committedFiles": [],
                "validation": [],
                "statusAfter": "clean",
            }
        ),
        encoding="utf-8",
    )
    proc, out = run_hook(hook_cmd, evidence_event, env)
    report(proc.returncode == 0, "Stop dirty evidence exits 0")
    report(not proc.stderr, "Stop dirty evidence stderr empty")
    report(out == {"continue": True}, "dirty repo with closeout evidence continues")

sys.exit(failed)
