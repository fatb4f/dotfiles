#!/usr/bin/env python3
"""Legacy rollback adapter.

Active Hookrail wrappers use the Bashly-generated adapter at
shell-wrap/src/hookrail/hookrail, with CUE semantics in cue.mods/hookrail.
Keep this file only as a temporary rollback artifact.
"""
from __future__ import annotations

import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


def env_int(name: str, default: int) -> int:
    try:
        return int(os.environ.get(name, str(default)))
    except ValueError:
        return default


PROMPT_LARGE = env_int("HOOKRAIL_PROMPT_LARGE_CHARS", 50_000)
PROMPT_OVERSIZED = env_int("HOOKRAIL_PROMPT_OVERSIZED_CHARS", 100_000)
TOOL_LARGE = env_int("HOOKRAIL_TOOL_LARGE_CHARS", 50_000)
AGENT_FEED_CHARS = env_int("HOOKRAIL_AGENT_FEED_CHARS", 2_000)
STOP_PRESSURE = env_int("HOOKRAIL_STOP_PRESSURE_CHARS", 50_000)


class HookrailError(Exception):
    pass


def read_json() -> dict[str, Any]:
    try:
        data = json.load(sys.stdin)
    except Exception as exc:
        raise HookrailError(f"invalid JSON input: {exc}") from exc
    if not isinstance(data, dict):
        raise HookrailError("hook input must be a JSON object")
    return data


def payload_class(chars: int, large: int, oversized: int | None = None) -> str:
    if oversized is not None and chars >= oversized:
        return "oversized"
    if chars >= large:
        return "large"
    return "small"


def json_chars(value: Any) -> int:
    if isinstance(value, str):
        return len(value)
    try:
        return len(json.dumps(value, ensure_ascii=False, sort_keys=True))
    except Exception:
        return len(str(value))


def truncate(text: str, limit: int = AGENT_FEED_CHARS) -> str:
    if len(text) <= limit:
        return text
    return text[: max(0, limit - 80)] + "\n...[hookrail truncated bounded agentFeed]..."


def state_root() -> Path | None:
    raw = os.environ.get("HOOKRAIL_STATE")
    if not raw:
        return None
    return Path(raw)


def git_cmd(cwd: str | Path, args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(cwd), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=2,
        check=False,
    )


def is_git_repo(cwd: str | Path | None) -> bool:
    if not cwd:
        return False
    try:
        proc = git_cmd(cwd, ["rev-parse", "--is-inside-work-tree"])
    except Exception:
        return False
    return proc.returncode == 0 and proc.stdout.strip() == "true"


def git_dirty(cwd: str | Path | None) -> bool:
    if not cwd or not is_git_repo(cwd):
        return False
    try:
        proc = git_cmd(cwd, ["status", "--porcelain"])
    except Exception:
        return False
    return proc.returncode == 0 and bool(proc.stdout.strip())


def git_head(cwd: str | Path | None) -> str | None:
    if not cwd or not is_git_repo(cwd):
        return None
    try:
        proc = git_cmd(cwd, ["rev-parse", "HEAD"])
    except Exception:
        return None
    if proc.returncode != 0:
        return None
    head = proc.stdout.strip()
    return head or None


def commit_before_summary_enabled() -> bool:
    raw_env = os.environ.get("HOOKRAIL_COMMIT_BEFORE_SUMMARY")
    if raw_env is not None:
        return raw_env.strip().lower() not in {"0", "false", "no", "off"}

    root = state_root()
    if root is not None:
        policy_path = root / "policy.json"
        if policy_path.exists():
            try:
                policy = json.loads(policy_path.read_text(encoding="utf-8"))
                return bool(policy.get("commitBeforeSummary", True))
            except Exception:
                return True

    return True


def user_opted_out_of_commit(event: dict[str, Any]) -> bool:
    for key in ("commit_before_summary", "commitBeforeSummary"):
        if event.get(key) is False:
            return True
    return False


def git_closeout_evidence_path(event: dict[str, Any]) -> Path | None:
    d = turn_dir(event)
    if d is None:
        return None
    return d / "git-closeout.json"


def trace_head_changed(event: dict[str, Any], current_head: str | None) -> bool:
    root = state_root()
    session_id = event.get("session_id")
    if root is None or not session_id or not current_head:
        return False

    trace_path = root / "trace" / f"{session_id}.jsonl"
    if not trace_path.exists():
        return False

    cwd = event.get("cwd", "")
    turn_id = event.get("turn_id", "session")
    try:
        for line in trace_path.read_text(encoding="utf-8", errors="replace").splitlines():
            if not line:
                continue
            row = json.loads(line)
            if row.get("cwd") != cwd:
                continue
            if row.get("turnID") not in {turn_id, "session"}:
                continue
            row_head = row.get("gitHead")
            if row_head and row_head != current_head:
                return True
    except Exception:
        return False
    return False


def commit_evidence_exists(event: dict[str, Any]) -> bool:
    evidence_path = git_closeout_evidence_path(event)
    if evidence_path is not None and evidence_path.exists():
        return True
    return trace_head_changed(event, git_head(event.get("cwd")))


def build_git_closeout_reason() -> str:
    return """Before final summary, complete git closeout.

Use the git-workflow procedure:

1. Inspect `git status --short`.
2. Inspect unstaged and staged diffs.
3. Stage only files directly related to this completed task.
4. Verify the staged diff.
5. Generate an accurate Conventional Commit message from the staged diff.
6. Commit using configured Git MCP write tools when available; otherwise use shell git.
7. Check final git status.
8. Then print the final summary with:
   - commit SHA
   - staged/committed files
   - validation commands and results

Do not print the final task summary until the commit succeeds, or until you clearly explain why committing is impossible."""


def turn_dir(event: dict[str, Any]) -> Path | None:
    root = state_root()
    if root is None:
        return None
    session_id = event.get("session_id") or "unknown-session"
    turn_id = event.get("turn_id") or "session"
    return root / "runs" / str(session_id) / str(turn_id)


def next_event_path(events_dir: Path, hook_event_name: str) -> Path:
    events_dir.mkdir(parents=True, exist_ok=True)
    existing = sorted(events_dir.glob("[0-9][0-9][0-9][0-9][0-9][0-9]-*.json"))
    if existing:
        try:
            seq = int(existing[-1].name.split("-", 1)[0]) + 1
        except Exception:
            seq = len(existing) + 1
    else:
        seq = 1
    slug = slugify(hook_event_name)
    return events_dir / f"{seq:06d}-{slug}.json"


def slugify(value: str) -> str:
    with_word_boundaries = re.sub(r"(?<!^)(?=[A-Z])", "-", value)
    return re.sub(r"[^a-z0-9]+", "-", with_word_boundaries.lower()).strip("-")


def atomic_write_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(
        prefix=f".{path.name}.", suffix=".tmp", dir=str(path.parent)
    )
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2, sort_keys=True)
            fh.write("\n")
        os.replace(tmp_name, path)
    except Exception:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass
        raise


def persist_manifest(event: dict[str, Any], manifest: dict[str, Any]) -> str | None:
    d = turn_dir(event)
    if d is None:
        return None
    p = next_event_path(d / "events", event.get("hook_event_name", "unknown"))
    manifest["capture"]["path"] = str(p)
    atomic_write_json(p, manifest)
    return str(p)


def append_trace(
    event: dict[str, Any],
    persisted: bool,
    manifest_path: str | None,
) -> None:
    root = state_root()
    if root is None:
        return
    session_id = event.get("session_id") or "unknown-session"
    trace_dir = root / "trace"
    trace_dir.mkdir(parents=True, exist_ok=True)
    row = {
        "timestamp": datetime.now(UTC).isoformat().replace("+00:00", "Z"),
        "hookEventName": event.get("hook_event_name"),
        "sessionID": event.get("session_id", "unknown-session"),
        "turnID": event.get("turn_id", "session"),
        "cwd": event.get("cwd", ""),
        "gitHead": git_head(event.get("cwd")),
        "model": event.get("model", ""),
        "transcriptPath": event.get("transcript_path"),
        "persisted": persisted,
        "manifestPath": manifest_path,
    }
    with (trace_dir / f"{session_id}.jsonl").open("a", encoding="utf-8") as fh:
        json.dump(row, fh, sort_keys=True, separators=(",", ":"))
        fh.write("\n")


def try_append_trace(
    event: dict[str, Any],
    persisted: bool,
    manifest_path: str | None,
) -> None:
    try:
        append_trace(event, persisted, manifest_path)
    except Exception:
        pass


def stop_warning(_event: dict[str, Any], chars: int) -> str | None:
    if chars >= STOP_PRESSURE:
        return "hookrail: stop observed; session pressure threshold crossed."
    return None


def base_output_context(hook_name: str, text: str | None) -> dict[str, Any]:
    out: dict[str, Any] = {"continue": True}
    if hook_name in {"SessionStart", "UserPromptSubmit", "PostToolUse"}:
        specific: dict[str, Any] = {"hookEventName": hook_name}
        if text:
            specific["additionalContext"] = truncate(text)
        out["hookSpecificOutput"] = specific
    elif text:
        out["systemMessage"] = truncate(text)
    return out


def build_manifest(
    event: dict[str, Any],
    chars: int,
    klass: str,
    persist: bool,
    reason: str,
    agent_text: str | None,
    output: dict[str, Any],
) -> dict[str, Any]:
    return {
        "schema": "hookrail.manifest.v1",
        "hookEventName": event.get("hook_event_name"),
        "sessionID": event.get("session_id", "unknown-session"),
        "turnID": event.get("turn_id", "session"),
        "cwd": event.get("cwd", ""),
        "model": event.get("model", ""),
        "transcriptPath": event.get("transcript_path"),
        "payload": {
            "chars": chars,
            "class": klass,
        },
        "capture": {
            "persist": persist,
            "reason": reason,
        },
        "agentFeed": {
            "inject": bool(agent_text),
            "budgetChars": AGENT_FEED_CHARS,
            **({"text": truncate(agent_text)} if agent_text else {}),
        },
        "output": output,
    }


def handle_session_start(event: dict[str, Any]) -> tuple[dict[str, Any], str | None]:
    source = event.get("source", "unknown")
    text = None
    root = state_root()
    frame_path = root / "frames" / "current.md" if root else None
    if frame_path and frame_path.exists():
        text = "hookrail frame:\n" + frame_path.read_text(
            encoding="utf-8", errors="replace"
        )
    elif source == "resume":
        text = "hookrail: resumed session; prefer compact frame/handoff when prior context pressure is high."
    out = base_output_context("SessionStart", text)
    manifest = build_manifest(
        event, 0, "small", bool(text), "session-start-frame", text, out
    )
    manifest_path = persist_manifest(event, manifest) if text else None
    return out, manifest_path


def handle_user_prompt_submit(event: dict[str, Any]) -> tuple[dict[str, Any], str | None]:
    prompt = event.get("prompt", "")
    chars = len(prompt)
    klass = payload_class(chars, PROMPT_LARGE, PROMPT_OVERSIZED)
    text = None
    if klass != "small":
        text = f"hookrail: prompt payload is {klass} ({chars} chars). Prefer compact handoff/frame before continuing long sessions."
    out = base_output_context("UserPromptSubmit", text)
    if klass == "oversized":
        out["systemMessage"] = text
    manifest = build_manifest(event, chars, klass, True, "prompt-metadata", text, out)
    manifest["prompt"] = {
        "stored": False,
        "reason": "redacted-by-default",
    }
    manifest_path = persist_manifest(event, manifest)
    return out, manifest_path


def handle_post_tool_use(event: dict[str, Any]) -> tuple[dict[str, Any], str | None]:
    response = event.get("tool_response")
    chars = json_chars(response)
    klass = payload_class(chars, TOOL_LARGE, None)
    text = None
    if klass != "small":
        digest = hashlib.sha256(
            json.dumps(
                response, ensure_ascii=False, sort_keys=True, default=str
            ).encode()
        ).hexdigest()[:16]
        text = f"hookrail: large tool response captured out-of-band candidate ({chars} chars, sha256:{digest}). Injecting bounded summary only."
    out = base_output_context("PostToolUse", text)
    manifest = build_manifest(
        event, chars, klass, klass != "small", "tool-output-budget", text, out
    )
    manifest_path = persist_manifest(event, manifest) if klass != "small" else None
    return out, manifest_path


def handle_stop(event: dict[str, Any]) -> tuple[dict[str, Any], str | None]:
    msg = event.get("last_assistant_message") or ""
    chars = len(msg)
    klass = payload_class(chars, TOOL_LARGE, None)
    cwd = event.get("cwd")
    if (
        commit_before_summary_enabled()
        and not user_opted_out_of_commit(event)
        and is_git_repo(cwd)
        and git_dirty(cwd)
        and not commit_evidence_exists(event)
    ):
        if event.get("stop_hook_active") is True:
            out = {
                "continue": True,
                "systemMessage": "hookrail: git closeout gate already active; continuing without repeat block.",
            }
            manifest = build_manifest(
                event, chars, klass, True, "git-closeout-recursion-guard", msg or None, out
            )
            try:
                persisted = persist_manifest(event, manifest)
            except Exception:
                persisted = None
            return out, persisted

        out = {"decision": "block", "reason": build_git_closeout_reason()}
        manifest = build_manifest(
            event,
            chars,
            klass,
            True,
            "git-closeout-required",
            build_git_closeout_reason(),
            out,
        )
        try:
            persisted = persist_manifest(event, manifest)
        except Exception:
            persisted = None
        return out, persisted

    out = {"continue": True}
    warning = stop_warning(event, chars)
    if warning:
        out["systemMessage"] = warning
    manifest = build_manifest(event, chars, klass, True, "stop-closeout", msg or None, out)
    try:
        persisted = persist_manifest(event, manifest)
    except Exception as exc:
        return {
            "continue": True,
            "systemMessage": f"hookrail: stop closeout failed: {exc}",
        }, None
    if persisted is None:
        return {
            "continue": True,
            "systemMessage": "hookrail: stop closeout failed; no manifest was persisted.",
        }, None
    return out, persisted


HANDLERS = {
    "SessionStart": handle_session_start,
    "UserPromptSubmit": handle_user_prompt_submit,
    "PostToolUse": handle_post_tool_use,
    "Stop": handle_stop,
}


def noop_for(event_name: str) -> dict[str, Any]:
    if event_name in {"SessionStart", "UserPromptSubmit", "PostToolUse"}:
        return {"continue": True, "hookSpecificOutput": {"hookEventName": event_name}}
    return {"continue": True}


def main() -> int:
    event: dict[str, Any] | None = None
    manifest_path: str | None = None
    try:
        event = read_json()
        name = event.get("hook_event_name")
        handler = HANDLERS.get(name)
        if handler is None:
            output = {
                "continue": True,
                "systemMessage": f"hookrail: unsupported hook {name!r}; no-op.",
            }
            try_append_trace(event, False, None)
        else:
            output, manifest_path = handler(event)
            try_append_trace(event, manifest_path is not None, manifest_path)
    except Exception as exc:
        if event is not None:
            try_append_trace(event, False, manifest_path)
        # Context hooks must not poison stdout with malformed JSON. If the input was
        # malformed, the safest generic output is a stop-compatible continue object.
        output = {
            "continue": True,
            "suppressOutput": True,
            "systemMessage": f"hookrail no-op after adapter error: {exc}",
        }
    json.dump(output, sys.stdout, sort_keys=True, separators=(",", ":"))
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
