#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
install-to-codex-home - install hookrail and optionally append Codex config

Usage:
  install-to-codex-home [--append-config]

Environment:
  CODEX_HOME   Codex home directory. Defaults to $HOME/.codex if unset.

Behavior:
  - copies this tree to $CODEX_HOME/tools/hookrail
  - preserves executable modes for bin/ and hooks/
  - with --append-config, appends config/hookrail.config.toml to $CODEX_HOME/config.toml
    between idempotent marker comments
USAGE
}

append_config=no
while [[ $# -gt 0 ]]; do
  case "$1" in
    --append-config)
      append_config=yes
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      printf 'install-to-codex-home: unknown option: %s\n' "$1" >&2
      exit 64
      ;;
  esac
done

src_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
: "${CODEX_HOME:=${HOME:?HOME is required}/.codex}"
install_root="$CODEX_HOME/tools/hookrail"
cue_root="$CODEX_HOME/cue.mods/hookrail"
config_path="$CODEX_HOME/config.toml"

repo_root="$src_root"
while [[ "$repo_root" != / && ! -x "$repo_root/shell-wrap/src/hookrail/hookrail" ]]; do
  repo_root="$(dirname -- "$repo_root")"
done
if [[ ! -x "$repo_root/shell-wrap/src/hookrail/hookrail" ]]; then
  printf 'install-to-codex-home: unable to locate generated hookrail CLI\n' >&2
  exit 1
fi

mkdir -p "$CODEX_HOME/tools"
rm -rf "$install_root.tmp"
mkdir -p "$install_root.tmp"
mkdir -p "$CODEX_HOME/cue.mods"
rm -rf "$cue_root.tmp"
mkdir -p "$cue_root.tmp"

# Copy contents without depending on rsync.
( cd "$src_root" && tar cf - . ) | ( cd "$install_root.tmp" && tar xf - )

for dir in bin hooks scripts; do
  while IFS= read -r path; do
    base="${path##*/}"
    target="$install_root.tmp/$dir/${base#executable_}"
    mv "$path" "$target"
  done < <(find "$install_root.tmp/$dir" -maxdepth 1 -type f -name 'executable_*' | sort)
done

chmod +x "$install_root.tmp"/bin/* "$install_root.tmp"/hooks/* "$install_root.tmp"/scripts/*
cp "$repo_root/shell-wrap/src/hookrail/hookrail" "$install_root.tmp/bin/hookrail"
chmod +x "$install_root.tmp/bin/hookrail"
rm -rf "$install_root"
mv "$install_root.tmp" "$install_root"

( cd "$repo_root/cue.mods/hookrail" && tar cf - . ) | ( cd "$cue_root.tmp" && tar xf - )
rm -rf "$cue_root"
mv "$cue_root.tmp" "$cue_root"

printf 'installed hookrail: %s\n' "$install_root"

if [[ "$append_config" = yes ]]; then
  mkdir -p "$(dirname -- "$config_path")"
  touch "$config_path"

  begin='# hookrail begin'
  end='# hookrail end'

  tmp="$(mktemp)"
  awk -v begin="$begin" -v end="$end" '
    $0 == begin {skip=1; next}
    $0 == end {skip=0; next}
    skip != 1 {print}
  ' "$config_path" >"$tmp"

  {
    cat "$tmp"
    printf '\n%s\n' "$begin"
    cat "$src_root/config/hookrail.config.toml"
    printf '%s\n' "$end"
  } >"$config_path"
  rm -f "$tmp"

  printf 'updated config: %s\n' "$config_path"
fi

printf 'verify with: %s\n' "$CODEX_HOME/tools/hookrail/bin/hookrail doctor"
