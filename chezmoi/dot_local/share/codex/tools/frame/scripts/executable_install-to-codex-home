#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
install-to-codex-home - install frame and optionally append Codex config

Usage:
  install-to-codex-home [--append-config]

Environment:
  CODEX_HOME   Codex home directory. Defaults to $HOME/.codex if unset.
  FRAME_REPO   Frame source checkout. Defaults to $HOME/src/frame.

Behavior:
  - copies the Frame repository to $CODEX_HOME/tools/frame
  - preserves executable modes
  - with --append-config, appends config/frame.config.toml to $CODEX_HOME/config.toml
    between idempotent marker comments after removing old Frame and Hookrail
    managed blocks
  - writes a temporary hookrail compatibility shim at
    $CODEX_HOME/tools/hookrail/bin/hookrail
USAGE
}

append_config=no
while [[ $# -gt 0 ]]; do
  case "$1" in
    --append-config)
      append_config=yes
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      printf 'install-to-codex-home: unknown option: %s\n' "$1" >&2
      exit 64
      ;;
  esac
done

src_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
: "${CODEX_HOME:=${HOME:?HOME is required}/.codex}"
: "${FRAME_REPO:=${HOME:?HOME is required}/src/frame}"

install_root="$CODEX_HOME/tools/frame"
legacy_root="$CODEX_HOME/tools/hookrail"
config_path="$CODEX_HOME/config.toml"

if [[ ! -x "$FRAME_REPO/bin/frame" ]]; then
  printf 'install-to-codex-home: unable to locate frame repo: %s\n' "$FRAME_REPO" >&2
  exit 1
fi

mkdir -p "$CODEX_HOME/tools"
rm -rf "$install_root.tmp"
mkdir -p "$install_root.tmp"

# Copy the runtime tree so the installed binaries resolve their sibling paths
# from the installed root rather than the source checkout. Keep git metadata so
# `frame doctor` can discover the repo root inside the installed tree.
( cd "$FRAME_REPO" && tar cf - --exclude=.frame . ) | ( cd "$install_root.tmp" && tar xf - )

rm -rf "$install_root"
mv "$install_root.tmp" "$install_root"

mkdir -p "$legacy_root/bin"
cat >"$legacy_root/bin/hookrail" <<'EOF'
#!/usr/bin/env sh
set -eu

: "${CODEX_HOME:=${HOME:?HOME is required}/.codex}"
exec "$CODEX_HOME/tools/frame/bin/frame" hookrail "$@"
EOF
chmod +x "$legacy_root/bin/hookrail"

printf 'installed frame: %s\n' "$install_root"
printf 'installed compatibility shim: %s\n' "$legacy_root/bin/hookrail"

if [[ "$append_config" = yes ]]; then
  mkdir -p "$(dirname -- "$config_path")"
  touch "$config_path"

  frame_begin='# frame begin'
  frame_end='# frame end'
  hookrail_begin='# hookrail begin'
  hookrail_end='# hookrail end'

  tmp="$(mktemp)"
  awk -v frame_begin="$frame_begin" -v frame_end="$frame_end" \
      -v hookrail_begin="$hookrail_begin" -v hookrail_end="$hookrail_end" '
    $0 == frame_begin {skip=1; next}
    $0 == frame_end {skip=0; next}
    $0 == hookrail_begin {skip=1; next}
    $0 == hookrail_end {skip=0; next}
    skip != 1 {print}
  ' "$config_path" >"$tmp"

  {
    cat "$tmp"
    printf '\n%s\n' "$frame_begin"
    cat "$src_root/config/frame.config.toml"
    printf '%s\n' "$frame_end"
  } >"$config_path"
  rm -f "$tmp"

  printf 'updated config: %s\n' "$config_path"
  if grep -n 'tools/hookrail/hooks/' "$config_path" >/dev/null; then
    printf 'warning: stale unmarked Hookrail hooks remain in %s and must be removed\n' "$config_path" >&2
  fi
fi

printf 'verify with: %s\n' "$CODEX_HOME/tools/frame/bin/frame doctor"
