#!/usr/bin/env sh
set -eu

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/kitty"
mkdir -p "$state_dir"
log_argv="$(printf '%s' "$*" | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177')"
printf 'argv: [%s]\n' "$log_argv" >>"$state_dir/command-finished-notify.log"

status="${1:-unknown}"
status="$(printf '%s' "$status" | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177')"

case "${status:-unknown}" in
  0)
    title="Kitty command finished"
    body="status: 0"
    ;;
  *)
    title="Kitty command failed"
    body="status: ${status:-unknown}"
    ;;
esac

notify-send \
  --app-name="kitty" \
  --icon="/usr/share/icons/hicolor/scalable/apps/kitty.svg" \
  "$title" \
  "$body"
