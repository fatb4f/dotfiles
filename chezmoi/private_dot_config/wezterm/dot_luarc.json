{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.4",
    "path": [
      "?.lua",
      "?/init.lua",
      "modules/?.lua",
      "modules/?/init.lua",
      "colors/?.lua"
    ]
  },
  "diagnostics": {
    "globals": ["wezterm"]
  },
  "workspace": {
    "checkThirdParty": false
  },
  "completion": {
    "callSnippet": "Replace"
  },
  "hint": {
    "enable": true
  },
  "telemetry": {
    "enable": false
  }
}
