# ~/.config/chezmoi/chezmoi.toml
# Conservative local baseline for a chezmoi-managed $HOME.

sourceDir = "{{ .chezmoi.homeDir }}/src/dotfiles"
workingTree = "{{ .chezmoi.homeDir }}/src/dotfiles"
destDir = "{{ .chezmoi.homeDir }}"
cacheDir = "{{ .chezmoi.homeDir }}/.cache/chezmoi"
persistentState = "{{ .chezmoi.homeDir }}/.local/state/chezmoi/chezmoi.boltdb"
tempDir = "{{ .chezmoi.homeDir }}/.cache/chezmoi/tmp"
scriptTempDir = "{{ .chezmoi.homeDir }}/.cache/chezmoi/scripts"

mode = "file"
umask = 0o022
color = "auto"
verbose = false

# Keep source/target mutation explicit. Let your controller/wrappers own flow.
interactive = false

# Output data format for commands that emit structured data.
format = "json"

# Prefer external commands when present, but allow chezmoi's builtins as fallback.
useBuiltinGit = "auto"
useBuiltinAge = "auto"

[template]
options = ["missingkey=error"]

[add]
encrypt = false
secrets = "error"
templateSymlinks = false

[edit]
command = "nvim"
hardlink = true
apply = false
watch = false

[git]
command = "git"
autoAdd = false
autoCommit = false
autoPush = false
lfs = false

[status]
pathStyle = "relative"
exclude = []

[update]
apply = true
recurseSubmodules = true

[verify]
exclude = []

[gitHub]
refreshPeriod = 60000000000

[pinentry]
options = ["allow-external-password-cache"]

[interpreters]
py = { command = "python3" }
rb = { command = "ruby" }
pl = { command = "perl" }
nu = { command = "nu" }

[warnings]
configFileTemplateHasChanged = true

