// Minimal niri rescue config for ASUS Chromebook Plus CX34 / MARASOV
//
// Purpose:
//   - get a recoverable Wayland session
//   - use Alt as Mod, avoiding Chromebook Search/Super ambiguity
//   - launch kitty
//   - run Noctalia
//   - keep touchpad enabled; PIXA2342 is fixed by libinput local-overrides.quirks
//
// Controls:
//   Alt+Return      spawn kitty
//   Alt+Shift+Q     close focused window
//   Alt+Shift+E     exit niri immediately
//   Alt+Escape      recover if an app inhibits shortcuts

input {
    keyboard {
        xkb {
            layout "us"
        }

        repeat-delay 600
        repeat-rate 25
    }

    touchpad {
        tap
        dwt
        dwtp
        natural-scroll
        scroll-method "two-finger"
        click-method "clickfinger"
    }

    // Optional: constrain touchscreen to internal panel.
    // Use the real output name from `niri msg outputs`.
    touch {
        map-to-output "eDP-1"
    }

    // Make Mod deterministic on the Chromebook keyboard.
    mod-key "Alt"
    mod-key-nested "Super"
}

layout {
    gaps 8

    focus-ring {
        width 3
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        off
    }
}

prefer-no-csd

binds {
    Mod+Return { spawn "kitty"; }
    Mod+Shift+Q { close-window; }
    Mod+Shift+E { quit skip-confirmation=true; }
    Mod+Escape { toggle-keyboard-shortcuts-inhibit; }

    // Core Noctalia binds.
    Mod+Space { spawn "noctalia-ipc" "launcher" "toggle"; }
    Mod+S { spawn "noctalia-ipc" "controlCenter" "toggle"; }
    Mod+Comma { spawn "noctalia-ipc" "settings" "toggle"; }
    Mod+L allow-inhibiting=false { spawn "session-lock"; }
}
