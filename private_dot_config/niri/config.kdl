input {
    keyboard {
        xkb {
            layout "us"
        }

        repeat-delay 600
        repeat-rate 25
    }

    touchpad {
        tap
        dwt
        dwtp
        natural-scroll
        scroll-method "two-finger"
        click-method "clickfinger"
    }
}

layout {
    gaps 12
    center-focused-column "on-overflow"
    always-center-single-column
    default-column-display "normal"
    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        width 3
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border { off; }
    shadow { off; }

    insert-hint {
        on
        color "#ffc87f80"
    }
}

include "binds.kdl"
include "workspaces.kdl"

animations {
    off
}

gestures {
    hot-corners {
        off
    }
}

output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1
    position x=1536 y=0
    focus-at-startup
    layout {
      background-color "#000000"
    }
}

output "eDP-1" {
    mode "1920x1080@60.004"
    scale 1.25
    position x=0 y=0
    focus-at-startup
    layout {
      background-color "#000000"
    }
}

prefer-no-csd

environment {
  QT_QPA_PLATFORMTHEME "qt6ct"
}

