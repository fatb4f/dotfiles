binds {
    // --- Shell / app control ---
    Mod+D repeat=false hotkey-overlay-title="Launch Apps" { spawn "app-launcher"; }
    Mod+S repeat=false hotkey-overlay-title="Toggle Control Center" { spawn "noctalia-ipc" "controlCenter" "toggle"; }
    Mod+Escape repeat=false hotkey-overlay-title="Toggle Shortcut Inhibitor" { toggle-keyboard-shortcuts-inhibit; }
    Super+Alt+L repeat=false allow-inhibiting=false hotkey-overlay-title="Lock Session" { spawn "/home/_404/.local/bin/session-lock"; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    // --- Named workspace shortcuts ---
    Mod+1 { focus-workspace "browser"; }
    Mod+2 { focus-workspace "terminal"; }
    Mod+Shift+N { move-workspace-to-monitor-next; }

    // --- Minimal layout repair ---
    Mod+C { center-column; }
    Mod+F { maximize-column; }
    Mod+M { maximize-window-to-edges; }
    Mod+Shift+F { fullscreen-window; }
}
