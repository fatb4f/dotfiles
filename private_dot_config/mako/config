font=Geist 10
width=340
height=100
padding=12
margin=14

border-size=1
border-radius=10

background-color=#0D0B14E6
border-color=#1A1525
text-color=#E8E2F0

icons=1
max-icon-size=32
icon-location=left
icon-border-radius=8

anchor=top-right
layer=top
default-timeout=3500
ignore-timeout=0
max-visible=5
max-history=5
history=1

markup=1
format=<b>%s</b>\n%b
on-button-left=dismiss
on-button-middle=exec makoctl menu -n "$id" -- wmenu -p 'Action: '
on-button-right=dismiss-all

[app-name=System]
anchor=top-center
layer=overlay
width=300
height=72
padding=12
margin=8
border-radius=12
default-timeout=1000
ignore-timeout=1
history=0
format=<b>%s</b>\n%b

[category=audio]
background-color=#11111BE6
border-color=#89B4FAAA
text-color=#CDD6F4
progress-color=over #89B4FAAA
on-button-left=dismiss --no-history
on-button-right=dismiss-all

[category=brightness]
background-color=#11111BE6
border-color=#F9E2AFAA
text-color=#CDD6F4
progress-color=over #F9E2AFAA
on-button-left=dismiss --no-history
on-button-right=dismiss-all

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb category=audio]
invisible=0
default-timeout=700

[mode=do-not-disturb category=brightness]
invisible=0
default-timeout=700
