# Owner: user-session
# Class: session-companion
# Start: wayland-session@niri.desktop.target.wants
# Enablement: enabled for wayland-session@niri.desktop.target

[Unit]
Description=Noctalia shell
Documentation=https://github.com/noctalia-dev/noctalia-shell
PartOf=wayland-session@niri.desktop.target graphical-session.target
After=wayland-session@niri.desktop.target graphical-session.target
Requisite=wayland-session@niri.desktop.target

[Service]
Type=simple
ExecStart=/usr/bin/qs -c noctalia-shell
Restart=on-failure
RestartSec=1

[Install]
WantedBy=wayland-session@niri.desktop.target
