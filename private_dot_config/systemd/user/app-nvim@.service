# Owner: app-launch
# Class: transient app session
# Start: nvim-unit-launch
# Enablement: never enable directly

[Unit]
Description=Neovim app session %I
Documentation=man:nvim(1)
After=graphical-session.target wayland-session@niri.desktop.target
Requisite=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
Slice=app.slice
WorkingDirectory=%h
ExecStart=%h/.local/bin/nvim-unit-run %I
KillMode=control-group
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=app-nvim
TimeoutStopSec=10s
