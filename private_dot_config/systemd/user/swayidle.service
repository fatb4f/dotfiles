[Unit]
Description=Wayland idle manager
PartOf=wayland-session@niri.desktop.target graphical-session.target
After=wayland-session@niri.desktop.target graphical-session.target

[Service]
ExecStart=/usr/bin/swayidle -w timeout 600 '%h/.local/bin/session-lock' before-sleep '%h/.local/bin/session-lock'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=wayland-session@niri.desktop.target
