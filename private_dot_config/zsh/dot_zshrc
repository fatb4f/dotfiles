# ~/.config/zsh/.zshrc
[[ -o interactive ]] || return 0

# Interactive Zsh state/cache contract.
export ZSH_CACHE_DIR="${ZSH_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/zsh}"
export ZSH_STATE_DIR="${ZSH_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/zsh}"

if [[ ! -d "$ZSH_CACHE_DIR" || ! -d "$ZSH_STATE_DIR" ]]; then
  print -u2 "zsh: missing cache/state dirs; run bootstrap"
fi

# History belongs in state, not config.
HISTFILE="$ZSH_STATE_DIR/history"
HISTSIZE=50000
SAVEHIST=50000

setopt append_history
setopt share_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt extended_history
setopt aliases

# Completion artifacts belong in cache, not config.
zstyle ':zim:completion' dumpfile "$ZSH_CACHE_DIR/zcompdump"
zstyle ':completion::complete:*' cache-path "$ZSH_CACHE_DIR/zcompcache"

# Zim generated init belongs to bootstrap/provisioning, not runtime shell init.
export ZIM_HOME="${ZIM_HOME:-$ZSH_CACHE_DIR/zim}"
export ZIM_CONFIG_FILE="${ZIM_CONFIG_FILE:-$ZDOTDIR/zimrc}"

if [[ -r "$ZIM_HOME/init.zsh" ]]; then
  source "$ZIM_HOME/init.zsh"
else
  print -u2 "zim: missing $ZIM_HOME/init.zsh; run bootstrap"
fi

# Load after Zim so zsh-vi-mode keymap/prompt hooks are established before
# WezTerm adds shell-integration prompt, cwd, and user-var hooks.
if [[ "${TERM_PROGRAM:-}" == "WezTerm" ]] && (( $+commands[wezterm] )); then
  eval "$(wezterm shell-integration --shell zsh)"
fi
